{
  "name": "bc-design-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.19",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync": "node scripts/sync-workspace.mjs",
    "start": "pnpm run sync && expo start --dev-client",
    "web": "pnpm run sync && expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "build:web": "pnpm run sync && expo export --platform web"
  },
  "private": true
}
